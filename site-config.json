{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "shadowClawVersion": "287742ee15369fecf6220af2d003e068f94b9471",
  "site": {
    "title": "pwgen Knowledge Hub",
    "description": "WebAssembly password generator compiled for CLI, Custom Elements, ESM, Node.js, and Web App exploration, powered by ShadowClaw.",
    "themeColor": "#0f172a",
    "lang": "en-US"
  },
  "branding": {
    "titleText": "pwgen Knowledge Hub",
    "siteUrl": "https://kherrick.github.io/pwgen-knowledge-hub/",
    "repoUrl": "https://github.com/kherrick/pwgen-knowledge-hub",
    "repoLabel": "pwgen on GitHub",
    "faviconPath": "assets/icons/favicon.ico",
    "appleTouchIconPath": "assets/icons/apple-touch-icon.png",
    "notFoundPath": "404.html",
    "logoSlotHtml": "<svg class=\"header-title-logo\" viewBox=\"0 0 32 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"32\" height=\"32\" rx=\"8\" fill=\"var(--shadow-claw-bg-tertiary, #1e293b)\" stroke=\"var(--shadow-claw-border-color, transparent)\" stroke-width=\"1.5\"></rect><path d=\"M11 14v-3a5 5 0 1 1 10 0v3\" stroke=\"var(--shadow-claw-accent-primary, #38bdf8)\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path><rect x=\"7\" y=\"14\" width=\"18\" height=\"13\" rx=\"3\" fill=\"var(--shadow-claw-accent-primary, #38bdf8)\"></rect><circle cx=\"11.5\" cy=\"20.5\" r=\"1.5\" fill=\"var(--shadow-claw-bg-tertiary, #1e293b)\"></circle><circle cx=\"16\" cy=\"20.5\" r=\"1.5\" fill=\"var(--shadow-claw-bg-tertiary, #1e293b)\"></circle><circle cx=\"20.5\" cy=\"20.5\" r=\"1.5\" fill=\"var(--shadow-claw-bg-tertiary, #1e293b)\"></circle></svg>"
  },
  "pwa": {
    "manifestPath": "manifest.json"
  },
  "sitemapPath": "sitemap.xml",
  "assets": ["assets"],
  "sidebar": {
    "pagesHidden": false,
    "chatHidden": false,
    "tasksHidden": false,
    "filesHidden": false,
    "defaultPage": "pages"
  },
  "pages": {
    "sortOrder": "asc",
    "defaultPinnedPage": "/pages/main/index.html"
  },
  "theme": {
    "stylesheet": "pages/main/theme.css"
  },
  "customElements": {
    "allowedElements": [
      "mwc-button",
      "mwc-checkbox",
      "mwc-dialog",
      "mwc-drawer",
      "mwc-fab",
      "mwc-formfield",
      "mwc-icon-button-toggle",
      "mwc-icon-button",
      "mwc-icon",
      "mwc-linear-progress",
      "mwc-list-item",
      "mwc-list",
      "mwc-menu-surface",
      "mwc-menu",
      "mwc-notched-outline",
      "mwc-radio-list-item",
      "mwc-radio",
      "mwc-select",
      "mwc-slider",
      "mwc-snackbar",
      "mwc-switch",
      "mwc-tab-bar",
      "mwc-tab-indicator",
      "mwc-tab-scroller",
      "mwc-tab",
      "mwc-textarea",
      "mwc-textfield",
      "mwc-top-app-bar",
      "mwc-top-app-bar-fixed",
      "x-pwgen"
    ],
    "allowedDomains": ["kherrick.github.io", "unpkg.com"],
    "scripts": ["pages/main/pwgen-adapter.js"]
  },
  "security": {
    "iframeSandbox": [
      "allow-modals",
      "allow-scripts",
      "allow-popups",
      "allow-popups-to-escape-sandbox",
      "allow-same-origin"
    ],
    "scriptSrc": ["'unsafe-eval'"],
    "workerSrc": ["'self'", "blob:", "data:"],
    "connectSrc": [
      "'self'",
      "blob:",
      "data:",
      "https://kherrick.github.io",
      "https://unpkg.com"
    ]
  },
  "settings": {
    "assistantName": "pwgen",
    "defaultToolsProfile": "none"
  },
  "enabledTools": ["pwgen", "pwgen_help", "pwgen_entropy"]
}
